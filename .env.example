# Copy to ".env" and fill in. ".env" is gitignored and never reaches GitHub.
# On Replit, put the same names in Tools → Secrets instead.

# Lets the board commit to the repo. Fine-grained PAT, this repo only,
# Contents: Read and write. Leave empty to run read-only or from local files.
GITHUB_TOKEN=

# Optional: require this on every change. Without it the board is writable by
# anyone who has the URL. Agents send it as X-Board-Password.
BOARD_PASSWORD=

# Pookachu Bot — a Hermes model works the tasks assigned to 007.
# Set the key and the gateway starts the agent alongside the board.
HERMES_API_KEY=
# Confirm both in your Hermes Cloud dashboard. These are the defaults:
# HERMES_BASE_URL=https://inference-api.nousresearch.com/v1
# HERMES_MODEL=Hermes-4-70B
# AGENT_INTERVAL=300          seconds between passes
# AGENT_TASKS_PER_PASS=3
# AGENT_AUTORUN=1             also start the built-in agent (off by default — the Telegram bot is the agent)
