# Copy to ".env" and fill in. ".env" is gitignored and never reaches GitHub.
# On Replit, put the same names in Tools → Secrets instead.

# Where the gateway listens. Defaults to 4747 (3000 on Replit, where .replit maps it).
# PORT=4747

# Lets the board commit to the repo. Fine-grained token, this repo only,
# Contents: Read and write. Without it the gateway runs from tasks/ on disk
# (local mode) or read-only.
GITHUB_TOKEN=

# Optional: one password for the whole board. With it set, reading and writing
# through the gateway both need it; without it anyone with the URL can do both.
# Entered once per browser. Agents send it as X-Board-Password.
BOARD_PASSWORD=

# Optional: agents that may manage ANY task, not only their own ("PMO" rights).
# Comma-separated agent ids, e.g. 007,agent_x. Leave unset and every agent
# follows the "own tasks only" rule — the safe default for a fresh install.
# Renames, id changes and deletes stay refused for every agent.
PMO_AGENTS=

# Optional: point the gateway at another repo or folder.
# REPO_OWNER=Lionscraft-io
# REPO_NAME=workforce
# REPO_BRANCH=main
# TASKS_DIR=tasks
