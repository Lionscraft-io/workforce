# Copy this file to ".env" and fill in your values. ".env" is gitignored.
#
# To share ONE database between your local machine and the deployed Replit app,
# paste the SAME Postgres connection string here that Replit uses. In Replit,
# open the Database tab (or Secrets) and copy the DATABASE_URL value.
#
# Leave this unset to use the local data/board.json file instead.
DATABASE_URL=

# Optional: require this key on every write (agents send it as X-API-Key).
# Leave unset for an open board.
API_KEY=
